# Mario & Sonic at the Rio 2016 Olympic Games - NEX server configuration.
# Copy to .env and fill in. All PN_RIO2016_* names are specific to this server.

# --- PRUDP listeners ---
PN_RIO2016_AUTH_PORT=26000
PN_RIO2016_SECURE_PORT=26001
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates this into a ~15-char buffer (e.g. "protarium.lol",
# NOT "secure.protarium.lol").
PN_RIO2016_SECURE_HOST=protarium.lol

# --- Database ---
PN_RIO2016_POSTGRES_URI=postgres://rio2016:rio2016@localhost:5432/rio2016?sslmode=disable

# --- Kerberos / system accounts ---
PN_RIO2016_KERBEROS_PASSWORD=change-me

# --- Auth mode -------------------------------------------------------------
# 1 = isolated preservation mode: accounts come from settings.json and the
#     login token is not validated. Leave the account-server vars below unset.
PN_RIO2016_LOCAL_MODE=1
PN_RIO2016_SETTINGS_PATH=settings.json

# Required only when PN_RIO2016_LOCAL_MODE is not 1 (shared deployment behind
# a Protarium-style account server):
#   64 hex chars (AES-256) - must match the account server's NEX token key
PN_RIO2016_NEX_TOKEN_AES_KEY=
#   >=32 bytes as hex - must match the account server's NEX password secret
PN_RIO2016_NEX_PASSWORD_SECRET=

# --- Optional: DataStore score attachments (ghosts / photos) --------------
# Without an S3-compatible endpoint DataStore::PreparePostObject fails and the
# client aborts the score-upload flow before Ranking::UploadScore.
PN_S3_ENDPOINT=
PN_S3_ACCESS_KEY=
PN_S3_SECRET_KEY=
PN_S3_BUCKET=rio2016-datastore

# --- Optional: leaderboard admin web panel ------------------------------------
# Unset PN_RIO2016_ADMIN_PASSWORD to disable the panel entirely.
PN_RIO2016_ADMIN_PASSWORD=
PN_RIO2016_ADMIN_LISTEN=:8090
